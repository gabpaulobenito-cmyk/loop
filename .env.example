# ── Required ────────────────────────────────────────────────────────────
# PostgreSQL connection string. On Railway reference the Postgres service:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://localhost:5432/loop

# ── Optional ────────────────────────────────────────────────────────────
# HTTP port (Railway injects PORT automatically).
PORT=3000

# production | development | test
NODE_ENV=development

# Set to "true" when connecting to Postgres over a public TLS endpoint.
# Not needed for Railway's private network (postgres.railway.internal).
DATABASE_SSL=false

# Only used by `npm test` integration suites and `npm run test:e2e`.
TEST_DATABASE_URL=postgres://localhost:5432/loop_test
